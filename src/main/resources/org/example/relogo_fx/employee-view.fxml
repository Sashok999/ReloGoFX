<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.relogo_fx.EmployeeController"
            stylesheets="@style.css" styleClass="page">
    <top>
        <VBox spacing="22">
            <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                <Label text="ReloGo" styleClass="brand"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backButton" text="← Главное меню" onAction="#onBackButtonClick" styleClass="quiet-button"/>
            </HBox>
            <VBox spacing="8" styleClass="page-heading">
                <Label text="Сотрудники" styleClass="page-title"/>
                <Label text="Контакты, должности и зарплаты команды" styleClass="subtitle"/>
            </VBox>
            <FlowPane hgap="10" vgap="10" styleClass="toolbar">
                <Button fx:id="createEmployeeButton" text="+ Добавить" onAction="#onCreateEmployeeButtonClick" styleClass="primary-button"/>
                <Button fx:id="updateEmployeeButton" text="Изменить" onAction="#onUpdateEmployeeButtonClick"/>
                <Button fx:id="deleteEmployeeButton" text="Удалить" onAction="#onDeleteEmployeeButtonClick" styleClass="danger-button"/>
                <Button fx:id="refreshEmployeeButton" text="Обновить" onAction="#onRefreshEmployeeButtonClick"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="18" right="32" bottom="16" left="32"/></padding>
            <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idEmployee" text="ID" prefWidth="65" minWidth="55"/>
                    <TableColumn fx:id="fullNameEmployee" text="ФИО" prefWidth="250" minWidth="55"/>
                    <TableColumn fx:id="phoneEmployee" text="Телефон" prefWidth="180" minWidth="55"/>
                    <TableColumn fx:id="roleEmployee" text="Должность" prefWidth="160" minWidth="55"/>
                    <TableColumn fx:id="salaryEmployee" text="Зарплата, ₽" prefWidth="150" minWidth="55"/>
                </columns>
            </TableView>
            <Label text="Выберите строку, чтобы изменить или удалить запись" styleClass="hint"/>
        </VBox>
    </center>
    <bottom><Label fx:id="statusLabel" text="Загрузка…" styleClass="footer"/></bottom>
</BorderPane>
