<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.mirea.movingcompany.belov.controllers.MovingOrderController"
            stylesheets="@style.css" styleClass="page">
    <top>
        <VBox spacing="22">
            <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                <Label text="ReloGo" styleClass="brand"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backButton" text="← Главное меню" onAction="#onBackButtonClick" styleClass="quiet-button"/>
            </HBox>
            <VBox spacing="8" styleClass="page-heading">
                <Label text="Заказы на переезд" styleClass="page-title"/>
                <Label text="Маршруты и ответственные за каждый переезд" styleClass="subtitle"/>
            </VBox>
            <FlowPane hgap="10" vgap="10" styleClass="toolbar">
                <Button fx:id="createMovingOrderButton" text="+ Добавить" onAction="#onCreateMovingOrderButtonClick" styleClass="primary-button"/>
                <Button fx:id="updateMovingOrderButton" text="Изменить" onAction="#onUpdateMovingOrderButtonClick"/>
                <Button fx:id="deleteMovingOrderButton" text="Удалить" onAction="#onDeleteMovingOrderButtonClick" styleClass="danger-button"/>
                <Button fx:id="refreshMovingOrderButton" text="Обновить" onAction="#onRefreshMovingOrderButtonClick"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="18" right="32" bottom="16" left="32"/></padding>
            <TableView fx:id="movingOrderTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idMovingOrder" text="ID" prefWidth="55" minWidth="55"/>
                    <TableColumn fx:id="clientMovingOrder" text="Клиент" prefWidth="190" minWidth="55"/>
                    <TableColumn fx:id="foremanMovingOrder" text="Бригадир" prefWidth="190" minWidth="55"/>
                    <TableColumn fx:id="massMovingOrder" text="Масса, кг" prefWidth="95" minWidth="55"/>
                    <TableColumn fx:id="startAddressMovingOrder" text="Откуда" prefWidth="210" minWidth="55"/>
                    <TableColumn fx:id="endAddressMovingOrder" text="Куда" prefWidth="210" minWidth="55"/>
                    <TableColumn fx:id="statusMovingOrder" text="Статус" prefWidth="140" minWidth="55"/>
                </columns>
            </TableView>
            <Label text="Выберите строку, чтобы изменить или удалить запись" styleClass="hint"/>
        </VBox>
    </center>
    <bottom><Label fx:id="statusLabel" text="Загрузка…" styleClass="footer"/></bottom>
</BorderPane>

